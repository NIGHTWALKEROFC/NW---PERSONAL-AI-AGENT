# Copy this file to .env and adjust if needed.
# .env is gitignored — never commit real values here.

# Ollama server address (default is correct for local install)
OLLAMA_HOST=http://localhost:11434

# Which model the agent uses by default.
# Change this later via config/model_config.json instead of editing code.
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Request timeout in seconds for model calls
OLLAMA_TIMEOUT=120

# Telegram Bot API token (Phase 10). Get one by messaging @BotFather on
# Telegram and sending /newbot. This is a BOT identity you create and
# control — not your personal Telegram account. Leave blank to disable
# the Telegram connector.
TELEGRAM_BOT_TOKEN=

# --- Phase 13: Instagram and WhatsApp (both via Meta's Graph API) ---
# Both require a Meta Developer app and both deliver messages by
# webhook push, not polling — see webhooks/webhook_server.py and
# scripts/run_webhook_server.py. Leave any of these blank to disable
# that connector.

# Instagram DMs — full setup steps in connectors/instagram/instagram_adapter.py
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_SENDER_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Business Platform (Cloud API) — full setup steps in
# connectors/whatsapp/whatsapp_adapter.py. This is the one official
# WhatsApp integration path; "WhatsApp" and "WhatsApp Business" are
# not two separate things here.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Port scripts/run_webhook_server.py listens on (0.0.0.0). Only matters
# if you're using Instagram and/or WhatsApp.
WEBHOOK_SERVER_PORT=8001
